; Engine configuration file.
; Godot 4.7 — SENTINEL

config_version=5

[application]

config/name="SENTINEL"
config/description="Mobile RTS. Grey-box vertical slice — Biodome 01."
run/main_scene="res://scenes/proto/proto_main.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[autoload]

EventBus="*res://autoload/event_bus.gd"
GameData="*res://autoload/game_data.gd"

[display]

window/size/viewport_width=2400
window/size/viewport_height=1080
; 0 = landscape. An RTS wants width: more map on screen, and the side panels
; have somewhere to live that is not on top of the battlefield.
window/handheld/orientation=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
; Debanding. The terrain's shading is now continuous gradients over large
; areas, which is exactly the case an 8-bit swapchain quantises into visible
; contours. This adds a dither at the end of tonemap and is supported on the
; Mobile renderer. It fixes PRECISION banding only — it would have done
; nothing about the posterisation that used to be authored into the shader.
anti_aliasing/quality/use_debanding=true
