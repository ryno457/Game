; SPIKE A — deformable terrain performance. THROWAWAY.
; Standalone project on purpose: it must be deletable in one `rm -rf` without
; touching the game. Nothing here is meant to ship.

config_version=5

[application]

config/name="SENTINEL Spike A — Terrain Perf"
config/description="Measures whether a deformable heightfield holds 60fps on a mid-range Android phone under thermal load. No gameplay."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[display]

window/size/viewport_width=1080
window/size/viewport_height=2400
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
; vsync stays ON: we are measuring whether the device HOLDS 60, not how far
; past it a hot loop can run. A soak that renders 300fps never throttles.
; Rendering thread stays on the default (Safe). Godot flags the separate
; rendering thread as experimental, and an experimental threading mode would
; confound the very number this spike exists to measure.
