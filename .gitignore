.godot/
android/
# Export presets can carry keystore paths and passwords, so they are ignored by
# default. The Spike A preset is deliberately keystore-free and IS tracked, so
# `Project -> Export -> Android` works from a fresh clone without setup.
export_presets.cfg
!spikes/01-terrain-perf/export_presets.cfg
*.translation
addons/gut/
build/
__pycache__/

# Blender writes a .blend1 backup beside every save. It is a copy of the
# previous version of a file that is itself generated by a script — two
# layers of redundancy, at 48 MB each.
*.blend1
